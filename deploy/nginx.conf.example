# Example nginx site for a single-host Function Planner deploy.
# Copy into sites-available (or include from nginx.conf), then adjust:
#   - server_name
#   - ssl_certificate / ssl_certificate_key
#   - root (must be apps/client/dist after `npm run build`, or a deploy copy of that tree)
#   - upstream port if the API does not listen on 3000
#
# Path split matches the Vite dev proxy: /api, /auth, /yjs → Node; everything else → SPA.
# There is no conflict on /yjs — that path is the API WebSocket only; the client connects to it.
#
# Long-cache only hashed /assets/* (Vite content-hashed filenames, including GoJS).
# Never long-cache HTML or other unhashed paths.

upstream function_planner_api {
  server 127.0.0.1:3000;
}

server {
  listen 443 ssl http2;
  server_name planner.example.edu;

  # ssl_certificate     /etc/letsencrypt/live/planner.example.edu/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/planner.example.edu/privkey.pem;

  root /opt/function-planner/apps/client/dist;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 256;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    image/svg+xml
    application/wasm;

  # Uncomment if ngx_brotli is installed:
  # brotli on;
  # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

  location /api/ {
    proxy_pass http://function_planner_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /auth/ {
    proxy_pass http://function_planner_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /yjs {
    proxy_pass http://function_planner_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }

  location /healthz {
    proxy_pass http://function_planner_api;
  }

  # Content-hashed Vite assets (incl. GoJS) — cache forever across client redeploys
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    etag off;
    try_files $uri =404;
  }

  # SPA shell — must revalidate so new hashed chunk names are discovered
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
